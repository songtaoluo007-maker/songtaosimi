# === 数据库 ===
DATABASE_URL=sqlite:///./data/fund_quant.db

# === AI配置 ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# === 服务端口 ===
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# === 本地账号与会话 ===
# 留空时系统会在 data/app_secret.key 自动生成本机密钥
APP_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# === 行情采集 ===
MARKET_COLLECT_INTERVAL_MINUTES=5
FUND_ESTIMATE_INTERVAL_MINUTES=30
AI_ADVICE_HOUR=14
AI_ADVICE_MINUTE=30
AI_ADVICE_PRE_REFRESH=true
AI_NEWS_LOOKBACK_DAYS=3

# === 日志 ===
LOG_LEVEL=INFO
LOG_DIR=./data/logs
